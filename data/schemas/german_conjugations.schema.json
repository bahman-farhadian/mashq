{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tartarus.local/schemas/german_conjugations.schema.json",
  "title": "Tartarus German conjugations",
  "description": "German verb records consumed by the deterministic conjugation practice engine.",
  "type": "object",
  "additionalProperties": {
    "$ref": "#/$defs/verb"
  },
  "$defs": {
    "six_person_forms": {
      "type": "array",
      "description": "Forms ordered as ich, du, er/sie/es, wir, ihr, sie/Sie.",
      "prefixItems": [
        { "type": "string", "minLength": 1 },
        { "type": "string", "minLength": 1 },
        { "type": "string", "minLength": 1 },
        { "type": "string", "minLength": 1 },
        { "type": "string", "minLength": 1 },
        { "type": "string", "minLength": 1 }
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    },
    "verb": {
      "type": "object",
      "required": [
        "infinitiv",
        "translation",
        "verb_class",
        "english",
        "indikativ"
      ],
      "properties": {
        "infinitiv": {
          "type": "string",
          "minLength": 1
        },
        "translation": {
          "type": "string",
          "minLength": 1
        },
        "verb_class": {
          "enum": ["weak", "strong", "mixed", "irregular"]
        },
        "hilfsverb": {
          "enum": ["haben", "sein"]
        },
        "partizip2": {
          "type": "string",
          "minLength": 1
        },
        "english": {
          "type": "object",
          "required": ["praesens"],
          "properties": {
            "praesens": {
              "$ref": "#/$defs/six_person_forms"
            }
          },
          "additionalProperties": true
        },
        "indikativ": {
          "type": "object",
          "required": ["praesens"],
          "properties": {
            "praesens": {
              "$ref": "#/$defs/six_person_forms"
            },
            "praeteritum": {
              "$ref": "#/$defs/six_person_forms"
            },
            "perfekt": {
              "$ref": "#/$defs/six_person_forms"
            },
            "plusquamperfekt": {
              "$ref": "#/$defs/six_person_forms"
            },
            "futur1": {
              "$ref": "#/$defs/six_person_forms"
            },
            "futur2": {
              "$ref": "#/$defs/six_person_forms"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
